# Server
PORT=3000

# Database
DATABASE_URL=postgres://postgres@localhost:5432/fundermaps

# Application
APP_ID=app-default

# Better Auth (required)
AUTH_SECRET=your-secret-key-at-least-32-chars
BASE_URL=http://localhost:3000
# Login page the OIDC provider redirects unauthenticated users to (the auth SPA).
LOGIN_PAGE_URL=https://auth.fundermaps.com/login
# Comma-separated frontend origins allowed to call /api/auth/* (CSRF allowlist).
TRUSTED_ORIGINS=

# S3 / DigitalOcean Spaces (optional)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email via Resend (optional; unset = emails skipped)
RESEND_API_KEY=
MAIL_FROM=FunderMaps <noreply@funderdata.nl>
STUDIO_URL=https://studio.fundermaps.com

# PDF renderer (Gotenberg, self-hosted; optional)
# GOTENBERG_URL: base URL of the Gotenberg HTTP API.
# REPORT_RENDER_URL: report front-end Gotenberg renders into a PDF (defaults below).
GOTENBERG_URL=
REPORT_RENDER_URL=https://whale-app-nm9uv.ondigitalocean.app

# Proxy (optional)
PROXY_ENABLED=false
PROXY_HEADER=X-Forwarded-For

# Public intake (the terugmeldformulier). Shared secret the intake app presents;
# without it the whole /api/intake lane answers 503 rather than taking anonymous
# writes. Portal number baked into every meldcode — 01 is FunderMaps' own form.
INTAKE_TOKEN=
INTAKE_CLIENT_ID=1
