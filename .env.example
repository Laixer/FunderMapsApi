# Server
PORT=3000

# Database
DATABASE_URL=postgres://postgres@localhost:5432/fundermaps

# Application
APP_ID=app-default

# Better Auth (required)
AUTH_SECRET=your-secret-key-at-least-32-chars
BASE_URL=http://localhost:3000
# Comma-separated frontend origins allowed to call /api/auth/* (CSRF allowlist).
TRUSTED_ORIGINS=

# S3 / DigitalOcean Spaces (optional)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email via Resend (optional; unset = emails skipped)
RESEND_API_KEY=
MAIL_FROM=FunderMaps <noreply@funderdata.nl>
STUDIO_URL=https://studio.fundermaps.com

# PDF report (Typst, in-process; optional)
# PDF_FIXES: comma-separated fixes for defects of the old report (pdf/lib-back.typ `fixes`); empty = none.
PDF_FIXES=

# Public intake (the terugmeldformulier). Shared secret the intake app presents;
# without it the whole /api/intake lane answers 503 rather than taking anonymous
# writes.
INTAKE_TOKEN=
