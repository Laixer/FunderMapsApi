    "@better-auth/api-key": "^1.6.23",
    "@better-auth/core": "^1.6.23",
    "@better-auth/oauth-provider": "^1.6.23",
    "@hono/zod-validator": "^0.8.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
